# Copy this file to .env.local and replace the example values.
# .env.local is git-ignored. NEVER commit real keys.

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────
# Local values come from `npm run supabase:status` (run it in YOUR terminal):
#   API URL         -> NEXT_PUBLIC_SUPABASE_URL
#   Publishable key -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_replace_me

# Server-side URL. Leave empty when running `npm run dev` on the host;
# compose.yaml sets it to http://host.docker.internal:54321 inside Docker.
SUPABASE_INTERNAL_URL=

# Server-only key that BYPASSES RLS. Used only by Stripe webhooks and seeds
# (later phases). Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=sb_secret_example_replace_me

# Postgres connection for drizzle-kit (schema/migrations only).
# Default local Supabase database (public development default, not a secret).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Email (team invitations, phase 3) ───────────────────────────────
# Local: leave as is — Mailpit's SMTP port from the Supabase CLI (view mail at
# http://localhost:54324). Outside production these are also the defaults.
# Production: your SMTP provider's host/port/credentials.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Stocktill <no-reply@stocktill.test>"

# ── Stripe (test mode, phase 9) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_example_replace_me
STRIPE_WEBHOOK_SECRET=whsec_example_replace_me
STRIPE_PRICE_ID=price_example_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_example_replace_me
